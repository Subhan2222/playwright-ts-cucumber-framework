{
  "default": {
    "require": [
      "support/hooks.ts",
      "src/steps/**/*.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "format": [
      "progress",
      "html:test-results/reports/cucumber-report.html",
      "json:test-results/reports/cucumber-report.json",
      "allure-cucumberjs/reporter"
    ],
    "formatOptions": {
      "resultsDir": "test-results/allure-results"
    },
    "paths": [
      "src/features/**/*.feature"
    ]
  }
}